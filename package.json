{
  "name": "bettersanfernando",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "prepare": "husky",
    "convert-yaml": "node scripts/yaml-to-json.js",
    "dev:yaml": "pnpm run convert-yaml && pnpm run dev",
    "setup": "node scripts/setup-starter-kit.js",
    "index-content": "node scripts/index-content.mjs",
    "data:sync": "node scripts/sync-civic-data.mjs",
    "data:validate": "node scripts/validate-civic-data.mjs",
    "data:smoke": "node --experimental-strip-types scripts/smoke-civic-data-layer.ts",
    "project-map:smoke": "node --experimental-strip-types scripts/smoke-project-map.ts",
    "project-statistics:smoke": "node --experimental-strip-types scripts/smoke-project-statistics.ts",
    "population-statistics:smoke": "node --experimental-strip-types scripts/smoke-population-statistics.ts",
    "nav:smoke": "node --experimental-strip-types scripts/smoke-navigation.ts",
    "check:public-data-boundary": "node scripts/check-no-private-data.mjs",
    "test:public-data-boundary": "node --test scripts/check-no-private-data.test.mjs"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@bettergov/kapwa": "^1.2.4",
    "@tailwindcss/typography": "^0.5.18",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.2",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^4.0.1",
    "js-yaml": "^5.2.2",
    "lucide-react": "^0.575.0",
    "maplibre-gl": "^6.6.0",
    "meilisearch": "^0.60.0",
    "nuqs": "^2.6.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^17.0.11",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5"
  }
}
